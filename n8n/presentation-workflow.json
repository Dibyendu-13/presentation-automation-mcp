    {
      "parameters": {
        "jsCode": "const b = $json.body ?? $json;\nif (!b.content || typeof b.content !== 'string') throw new Error('content is required');\nconst nSlides = Math.max(3, Math.min(15, Number(b.nSlides || 6)));\nreturn [{ json: { content: b.content.trim(), instructions: String(b.instructions || ''), nSlides, tone: b.tone || 'professional', theme: ['midnight','paper'].includes(b.theme) ? b.theme : 'midnight' } }];"
      },
      "id": "afdeef02-d72c-4e72-9149-e8f45b7b487e",
      "name": "Validate request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        32,
        -64
      ]
    },
    {
      "parameters": {
        "modelId": {
          "__rl": true,
          "value": "gpt-4.1-mini",
          "mode": "list",
          "cachedResultName": "GPT-4.1-MINI",
          "cachedResultUrl": ""
        },
        "messages": {
          "values": [
            {
              "content": "You create concise presentation specifications. Return JSON only. The response must contain title, theme, and slides. Each slide has type (title, content, two-column, or closing), title, optional subtitle, bullets, and optional left/right arrays. Respect the requested slide count exactly. Use title for the first slide and closing for the last. Keep bullets under 18 words.",
              "role": "system"
            },
            {
              "content": "={{ `Topic/content: ${$json.content}\nInstructions: ${$json.instructions}\nSlides: ${$json.nSlides}\nTone: ${$json.tone}\nTheme: ${$json.theme}` }}",
              "role": "=user"
            }
          ]
        },
        "options": {
          "temperature": 0.4
        }
      },
      "id": "47583f49-87bf-4f24-9ec2-2f3f8a627a19",
      "name": "Generate structured deck",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 1.8,
      "position": [
        272,
        -64
      ],
      "credentials": {}
    },
    {
      "parameters": {
        "jsCode": "const raw =\n  $json.message?.content ??\n  $json.content ??\n  $json.text ??\n  $json;\n\nif (typeof raw !== \"string\") {\n  return [{ json: raw }];\n}\n\nconst start = raw.indexOf(\"{\");\nconst end = raw.lastIndexOf(\"}\");\n\nif (start === -1 || end === -1) {\n  throw new Error(\"The model response does not contain a JSON object\");\n}\n\nconst cleaned = raw.slice(start, end + 1);\nconst deck = JSON.parse(cleaned);\n\nif (!deck.title || !Array.isArray(deck.slides)) {\n  throw new Error(\"Invalid presentation structure\");\n}\n\nreturn [{ json: deck }];"
      },
      "id": "c1953369-0f18-4d8d-bb4d-bf4049397a4e",

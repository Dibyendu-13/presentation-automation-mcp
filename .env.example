# Frontend → n8n
VITE_N8N_WEBHOOK_URL=https://presentflow.app.n8n.cloud/webhook/generate-presentation

# n8n → renderer
RENDERER_URL=https://presentation-automation-mcp.onrender.com
RENDERER_PORT=3001

# Renderer-generated download URLs
PUBLIC_RENDERER_URL=https://presentation-automation-mcp.onrender.com

# MCP server → n8n
N8N_WEBHOOK_URL=https://presentflow.app.n8n.cloud/webhook/generate-presentation

# Leave unused unless webhook authentication is configured in n8n
WORKFLOW_API_KEY=

# OpenAI credentials remain inside n8n
OPENAI_API_KEY=
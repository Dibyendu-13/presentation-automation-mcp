# Public URL of the n8n production webhook.
VITE_N8N_WEBHOOK_URL=http://localhost:5678/webhook/generate-presentation

# Renderer API used by n8n.
RENDERER_URL=https://presentation-automation-mcp.onrender.com
RENDERER_PORT=3001
PUBLIC_RENDERER_URL=http://localhost:3001

# n8n webhook used by the MCP server.
N8N_WEBHOOK_URL=http://n8n:5678/webhook/generate-presentation

# Optional protection shared by the frontend/MCP caller and n8n webhook.
WORKFLOW_API_KEY=change-me

# LLM credential configured in n8n (recommended: store it as an n8n credential).
OPENAI_API_KEY=


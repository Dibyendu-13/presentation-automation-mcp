{
  "name": "presentflow",
  "version": "0.1.0",
  "private": true,
  "workspaces": ["frontend", "renderer", "mcp-server"],
  "scripts": {
    "dev:frontend": "npm run dev --workspace frontend",
    "dev:renderer": "npm run dev --workspace renderer",
    "dev:mcp": "npm run dev --workspace mcp-server",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "typescript": "5.7.3"
  },
  "overrides": {
    "typescript": "5.7.3"
  },
  "engines": {
    "node": "22.x"
  }
}
